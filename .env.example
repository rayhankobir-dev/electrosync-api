# Copy to `.env` and fill in. `.env` is gitignored.
#
# Validated at boot by src/config/env.validation.ts — the app refuses to start
# with an invalid or incomplete configuration rather than failing on the first
# request that needs the missing value.

# ---------------------------------------------------------------- required ---

# PostgreSQL connection string. Read by both the running app (via ConfigModule)
# and by drizzle-kit (via drizzle.config.ts), so there is a single source of
# truth for which database is being talked to.
#
# Local:  postgresql://postgres:postgres@localhost:5432/electrosync
# Neon:   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
#
# Prefer `sslmode=verify-full` on any hosted database. node-postgres currently
# treats `prefer`, `require` and `verify-ca` as aliases for it, but pg v9 adopts
# libpq semantics where `prefer` means "try TLS, fall back to plaintext, skip
# verification" — a silent downgrade on a routine dependency bump. Neon serves a
# Let's Encrypt certificate, so full verification works. Use `sslmode=disable`
# for a local server with no TLS.
DATABASE_URL=

# HTTP port. Optional; defaults to 3000.
PORT=3000

# Browser origins allowed to call the API, comma-separated. Required — at least
# one entry. Each is matched exactly (scheme, host and port all count), so list
# every origin the client is actually served from.
#
# Only browsers enforce CORS. An Expo app running natively sends no `Origin`
# header and is unaffected; the `exp://` entry matters for Expo Web and the dev
# client, and its LAN IP changes when the network does.
CORS_ORIGINS=http://localhost:8082

# RS256 keypair, PEM-encoded, with literal \n escapes — the JWT provider
# converts them back to real newlines. Both values must be double-quoted.
#
# Asymmetric rather than an HS256 shared secret because clients need to verify
# tokens: with HS256 the verification key IS the signing key, so shipping it in
# a mobile bundle would let anyone who extracts it mint a token for any account.
#
# Generate a pair with:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Token lifetime in days (1-365). Optional; defaults to 90.
#
# There is no session table and no refresh endpoint, so expiry is the only thing
# that stops a leaked token working. Rotating the keypair is the emergency
# lever, and it signs out every user at once.
JWT_EXPIRY_DAYS=90

# ---------------------------------------------------------------- optional ---

# Firebase service account, from Project Settings > Service Accounts >
# "Generate new private key". Optional as a group: omit all three and the app
# runs normally, but push sending returns 503 instead of delivering.
#
# FIREBASE_PRIVATE_KEY must stay double-quoted — it contains literal \n escapes
# that the app converts back to real newlines before handing them to Firebase.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ------------------------------------------------------------- outbound sms ---

# bulksmsbd gateway credentials, from your account dashboard. Optional as a
# pair: omit them and the app runs normally, but users who switched on SMS
# alerts get push only. A startup warning names that degradation.
#
# Both are required for the channel to arm. The sender ID must be one your
# account has had approved — an unapproved value is rejected on every send.
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# Overrides the gateway endpoint. Leave empty in production; it defaults to
#   https://bulksmsbd.net/api/smsapi
#
# HTTPS, not the http:// URL bulksmsbd's own docs show. The API key travels as
# a query parameter, so over plaintext every hop between here and Dhaka can
# read a credential with your prepaid balance behind it. Their TLS endpoint
# answers identically — set this to the http:// form only if that regresses.
#
# The other use is pointing staging at a mock, so test alerts cost nothing.
SMS_PROVIDER_URL=

# ------------------------------------------------------------ outbound mail ---

# SMTP credentials for password-reset codes. Optional as a group, keyed on
# SMTP_HOST: leave it empty and the app still boots and serves everything — the
# reset flow then writes each code to the server log instead of emailing it,
# which is what you want locally.
#
# A startup warning names that degradation, so an unconfigured production
# deployment shows up in the boot output rather than in a support ticket.
#
# Gmail:      smtp.gmail.com, port 587, an App Password (not your account
#             password — that requires 2FA enabled on the account)
# Mailgun:    smtp.mailgun.org, port 587
# Amazon SES: email-smtp.REGION.amazonaws.com, port 587
SMTP_HOST=
SMTP_PORT=587

# Implicit TLS from the first byte. Set true only for port 465; port 587
# upgrades in-band via STARTTLS and wants this false. Only the literal string
# "true" enables it.
#
# Getting this wrong does not error — it hangs, because a plaintext greeting to
# a port expecting a TLS handshake never gets answered.
SMTP_SECURE=false

SMTP_USER=
SMTP_PASSWORD=

# The From header. A bare address or a display form:
#   MAIL_FROM="ElectroSync <no-reply@electrosync.app>"
# Optional; defaults to SMTP_USER.
MAIL_FROM=

# ------------------------------------------------- scheduled balance sweep ---

# Polls every NESCO meter and pushes low-balance, depleted, and recharge
# alerts. Optional; defaults to enabled.
#
# Set to false in any environment that shares a database with production. The
# sweep sends real pushes to real phones, and its advisory lock coordinates
# instances against one database — it cannot stop a second environment pointed
# at the same rows from sending every alert a second time.
#
# Only the literal string "false" disables it; anything else counts as enabled.
ALERTS_ENABLED=true

# 5-field cron expression in the server's local timezone. Optional; defaults to
# every six hours on the hour.
#
# Each poll costs the NESCO portal two requests, and the portal is a scraped
# public website with no rate-limit contract — raise the frequency only with a
# reason.
ALERTS_CRON="0 */6 * * *"

# Meters polled simultaneously (1-20). Optional; defaults to 3.
ALERTS_CONCURRENCY=3

# ------------------------------------------------------- NESCO portal egress ---

# Proxy — or comma-separated list of proxies — for NESCO portal requests.
# Optional.
#
# customer.nesco.gov.bd answers HTTP 403 to every source IP outside Bangladesh —
# verified against 18 vantage points in 14 countries, all refused, while a
# Bangladeshi IP is served normally with any User-Agent (or none). The block
# applies to the initial GET too, so a backend hosted abroad cannot reach the
# portal at all and every lookup surfaces as a 502.
#
# Leave empty when the host is already in Bangladesh, local development
# included. Unset means a direct connection.
#
# Supported schemes: http, https, socks4, socks5. The cheapest reliable setup is
# an SSH tunnel to any Bangladeshi box:
#
#   ssh -N -D 0.0.0.0:1080 user@your-bd-host      # then use socks5://...
#
# Both legs of the portal exchange share one route, which matters: the CSRF
# token and session cookie from the GET are bound to the address the portal saw.
# Failover therefore re-runs the whole exchange, never just the POST.
#
# A LIST is supported because free public Bangladeshi proxies are individually
# unreliable but fail independently. The client walks the list per exchange
# until one answers and then sticks to it, so a dead entry costs a connect
# timeout once rather than on every request. Order them best-first.
#
# Measured warning: with a pool of seven free proxies, only 2 of 5 consecutive
# lookups succeeded, each taking 22-29s. Failover makes free proxies *work*; it
# does not make them dependable. Anything user-facing wants a BD host or a paid
# BD endpoint.
#
# Deliberately NOT named HTTPS_PROXY — that would divert every outbound client
# in the process. Postgres, Firebase and SMTP have no reason to detour.
#
# NESCO_PROXY_URL=socks5://127.0.0.1:1080
# NESCO_PROXY_URL=socks5://a.example:1080,http://b.example:8080
